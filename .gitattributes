# Consistent source/document line endings; binary assets must stay byte-identical.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.cjs text eol=lf
*.ps1 text eol=crlf
.gitignore text eol=lf
.env.example text eol=lf
*.pt -text
*.pth -text
*.onnx -text
*.mp4 -text
*.avi -text
