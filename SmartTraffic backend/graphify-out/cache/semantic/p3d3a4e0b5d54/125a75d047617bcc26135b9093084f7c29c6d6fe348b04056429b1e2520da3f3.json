{"nodes": [{"id": "readme_smart_traffic_ai", "label": "Smart Traffic AI (project README)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype adaptive traffic-signal management; explicitly not certified for real signals; DB integration and deployment not verified."}, {"id": "readme_live_traffic_mode", "label": "Live Traffic Mode", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_simulation_mode", "label": "Simulation Mode", "file_type": "concept", "source_file": "README.md", "source_location": "L300", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-process simulator with its own decision engine and observation store so a failure only sets its state to error while live traffic keeps running."}, {"id": "readme_live_simulation_isolation", "label": "Live/Simulation Data Isolation", "file_type": "rationale", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two channels share no state so simulated observations can never reach live state, live signal decisions or emergency preemption, and the live view never depends on the simulator."}, {"id": "readme_perception_system", "label": "Perception System (Python / YOLO)", "file_type": "concept", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_post_api_traffic", "label": "POST /api/traffic Contract", "file_type": "concept", "source_file": "README.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perception only sends one HTTP request per intersection per frame window (~1 Hz) and needs no knowledge of Socket.IO, Three.js, Leaflet or UI."}, {"id": "readme_reserved_source_tags", "label": "Reserved Source Tags (mock/simulation -> HTTP 422)", "file_type": "rationale", "source_file": "README.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejecting source 'mock'/'simulation' guarantees simulated data can never enter live state."}, {"id": "readme_perception_hold_time", "label": "PERCEPTION_HOLD_TIME Flicker Tolerance", "file_type": "rationale", "source_file": "README.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detections flicker frame to frame; pedestrian requests/emergencies are withdrawn only after absence for the hold time so one missed frame does not restart them."}, {"id": "readme_socket_io_rooms", "label": "Socket.IO Rooms (live / simulation)", "file_type": "concept", "source_file": "README.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every client starts in the live room so clients unaware of simulation keep working; switching via 'subscribe' returns a fresh init."}, {"id": "readme_snapshot", "label": "Intersection Snapshot Payload", "file_type": "concept", "source_file": "README.md", "source_location": "L200", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_swagger_api_docs", "label": "Swagger / OpenAPI 3.0 Documentation", "file_type": "concept", "source_file": "README.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_decision_engine", "label": "Traffic Decision Engine", "file_type": "concept", "source_file": "README.md", "source_location": "L208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One state machine per intersection ticking every 250 ms; the browser never decides signal state; only one approach green at a time so straight-through movements never conflict."}, {"id": "readme_signal_state_machine", "label": "Signal Phase State Machine (GREEN-YELLOW-ALL_RED-PED)", "file_type": "rationale", "source_file": "README.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_priority_score", "label": "Priority Score (vehicles*2 + waiting*3 + queue*2)", "file_type": "rationale", "source_file": "README.md", "source_location": "L220", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_emergency_preemption", "label": "Emergency Preemption and Hold", "file_type": "rationale", "source_file": "README.md", "source_location": "L228", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidence >= 0.80 preempts immediately even before minimum green; EMERGENCY_MAX_HOLD_TIME caps stuck detections; confirmed emergencies are not dropped on one weak frame."}, {"id": "readme_fixed_time_fallback", "label": "Fixed-Time Fallback (N-E-S-W)", "file_type": "rationale", "source_file": "README.md", "source_location": "L235", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_minimum_green", "label": "Minimum Green Time", "file_type": "rationale", "source_file": "README.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_exclusive_pedestrian_phase", "label": "Exclusive Pedestrian Phase", "file_type": "rationale", "source_file": "README.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All vehicle approaches red during WALK then clearance; emergency shortens WALK but never skips clearance; cooldown prevents same people re-triggering."}, {"id": "readme_fairness_guard", "label": "Fairness Guard (MAX_RED_TIME)", "file_type": "rationale", "source_file": "README.md", "source_location": "L244", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_adaptive_green", "label": "Adaptive Planned Green and Extension", "file_type": "rationale", "source_file": "README.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dashboard_frontend", "label": "Operations Dashboard Frontend", "file_type": "concept", "source_file": "README.md", "source_location": "L259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain HTML/CSS/ES modules served by the backend, no build step."}, {"id": "readme_3d_digital_twin", "label": "3D Intersection Digital Twin (Three.js)", "file_type": "concept", "source_file": "README.md", "source_location": "L281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A visualization, not a physics simulation; vehicles capped at 14 per approach and obey red/crosswalk/gap rules."}, {"id": "readme_network_map", "label": "Network Map (Leaflet + OpenStreetMap)", "file_type": "concept", "source_file": "README.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_intersection_selection", "label": "Intersection Selection (selectedId)", "file_type": "concept", "source_file": "README.md", "source_location": "L275", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_simulation_scenarios", "label": "Simulation Scenarios and Auto Tour", "file_type": "concept", "source_file": "README.md", "source_location": "L315", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_demo_flow", "label": "Judges Demo Flow", "file_type": "document", "source_file": "README.md", "source_location": "L59", "source_url": null, "