MONGODB_URI=
PORT=5500
# Public URL of the Python/Flask AI service, e.g. https://your-ai-service.onrender.com
# The Live AI tab loads <AI_STREAM_URL>/video/north, south, west and east from it.
# Set ALLOWED_ORIGINS on the AI service to this site's URL for the stream status checks.
AI_STREAM_URL=
# Shared secret the AI service sends with every POST /api/traffic. Set the same
# value as TRAFFIC_INGEST_TOKEN on the AI service. Leave blank only locally:
# without it anyone who can reach the backend can post traffic data.
TRAFFIC_INGEST_TOKEN=
# Surveyed position of the intersection the AI cameras watch (id "main").
# Driver navigation adds live traffic only to routes passing within 60 m of it.
# Blank = the placeholder position in config/intersections.js.
INTERSECTION_LAT=
INTERSECTION_LNG=
INTERSECTION_NAME=
# Bearer token for camera stream management (POST/PATCH/DELETE /api/streams).
# Blank = stream management is disabled (503). Never give it to the AI service.
STREAM_ADMIN_TOKEN=
# At most one stored traffic record per intersection per this many seconds
# (0 = every observation). Emergency / pedestrian / stream changes are always stored.
HISTORY_SAMPLE_SECONDS=5
# Network-wide coordination (services/networkCoordinator.js). Defaults shown.
# NETWORK_OPTIMIZATION=true          false = every intersection decides alone
# NETWORK_DECISION_INTERVAL=2        seconds between network decision cycles
# NETWORK_LINK_CAPACITY=40           vehicles one road between two intersections holds
# NETWORK_SPILLBACK_START=0.7        road occupancy where release is reduced
# NETWORK_SPILLBACK_BLOCK=0.9        ... and where it stops (spillback guard)
# Emergency corridor (services/emergencyCorridor.js)
# EMERGENCY_CORRIDOR_LENGTH=3        intersections prepared ahead of the vehicle
# EMERGENCY_CORRIDOR_PREPARE_SECONDS=30
# EMERGENCY_CORRIDOR_HOLD_SECONDS=8
# EMERGENCY_CORRIDOR_FROM_CAMERA=true  camera detections start a corridor (route assumed straight ahead)

# ---------------------------------------------------------------------------
# Mobile navigation API (/api/v1). Full list and defaults: docs/CONFIGURATION.md
# ---------------------------------------------------------------------------
# Behind a reverse proxy (Render, Nginx) set this so rate limits see the client
# IP, e.g. 1 (one proxy hop). Blank = no proxy.
TRUST_PROXY=
# Signs the anonymous device tokens of the app. 32+ random characters. Blank =
# a per-process secret: every app must re-register after each restart.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_SECRET=
# Bearer token for road-feature management and report moderation (operator
# tools only - never put it in the mobile app). Blank = those endpoints are disabled.
NAV_ADMIN_TOKEN=
# Contact address sent in the User-Agent to the OpenStreetMap services, as
# their usage policies ask. Recommended whenever the public services are used.
PROVIDER_CONTACT_EMAIL=
# Providers. Blank = the public OpenStreetMap services (development only:
# about one request per second for this whole server, no SLA). "off" = disabled.
# ROUTING_URL=https://router.project-osrm.org        OSRM HTTP API
# GEOCODING_URL=https://nominatim.openstreetmap.org  Nominatim-compatible API
# GEOCODING_API_KEY=                                  sent as ?key= (e.g. LocationIQ)
# GEOCODING_COUNTRY_CODES=                            e.g. iq - limit search to these countries
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Spacing between requests to one provider: default 1100 ms for the public hosts, 0 otherwise.
# ROUTING_MIN_INTERVAL_MS=  GEOCODING_MIN_INTERVAL_MS=  OVERPASS_MIN_INTERVAL_MS=
# ROUTING_VIA_ATTEMPTS=4             extra alternatives through via points (0 = OSRM's own only)
# PROVIDER_COOLDOWN_SECONDS=30       a failing provider is not called for this long
# NAV_ROUTE_INCLUDE_PLACEHOLDERS=false  match unsurveyed intersection positions to routes
