MONGODB_URI=
PORT=5500
# Public URL of the Python/Flask AI service, e.g. https://your-ai-service.onrender.com
# The Live AI tab loads <AI_STREAM_URL>/video/north, south, west and east from it.
# Set ALLOWED_ORIGINS on the AI service to this site's URL for the stream status checks.
AI_STREAM_URL=
# Shared secret the AI service sends with every POST /api/traffic. Set the same
# value as TRAFFIC_INGEST_TOKEN on the AI service. Leave blank only locally:
# without it anyone who can reach the backend can post traffic data.
TRAFFIC_INGEST_TOKEN=
# Surveyed position of the intersection the AI cameras watch (id "main").
# Driver navigation adds live traffic only to routes passing within 60 m of it.
# Blank = the placeholder position in config/intersections.js.
INTERSECTION_LAT=
INTERSECTION_LNG=
INTERSECTION_NAME=
