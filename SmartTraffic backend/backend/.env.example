# Hawr / SmartTraffic backend configuration. Copy this file to backend/.env and fill it in.
# Never commit backend/.env: it holds secrets. Only variables the code reads are listed.
# The full list with every default is in docs/CONFIGURATION.md.
#
# For each variable: what it is for, whether it is required, where to get it, an example,
# and who uses it. Generate any secret/token below with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT - port the backend listens on. Optional (default 3000). Used by: server.js.
PORT=3000
# NODE_ENV - "production" turns on the production start checks (docs/DEPLOYMENT.md): the
# backend refuses to start without TRAFFIC_INGEST_TOKEN, MONGODB_URI and the two token
# secrets, and the simulation write endpoints answer 403. Optional; blank = development.
# Used by: config/index.js.
NODE_ENV=
# CORS_ORIGIN - websites allowed to call the API from a browser, comma separated and exact.
# Optional. Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Blank = any localhost origin in development, none in production. "*" = every website
# (not recommended). Native mobile apps send no Origin and are not affected; a webview app
# (Capacitor / Ionic) needs its origin here, e.g. capacitor://localhost. Used by: utils/cors.js.
CORS_ORIGIN=
# TRUST_PROXY - number of reverse proxies in front (1 on Render / Nginx) so rate limits see
# the real client address. Optional; blank = no proxy. Used by: server.js.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
# MONGODB_URI - accounts, driver reports, road features, local places, saved places and
# traffic history. Required in production; optional in development (the backend starts and
# says what does not work). If it is set, the backend refuses to start when it cannot connect.
# Where: local MongoDB or a free cluster at https://www.mongodb.com/atlas.
# Example local: mongodb://127.0.0.1:27017/smarttraffic
# Example Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smarttraffic
# Used by: config/database.js.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Map: OpenFreeMap (vector tiles, drawn with MapLibre). No key, no request limit.
# ---------------------------------------------------------------------------
# OPENFREEMAP_STYLE_URL - the MapLibre style the web and mobile apps load. Optional.
# Default https://tiles.openfreemap.org/styles/liberty . Other styles are listed at
# https://openfreemap.org/quick_start/ (liberty, bright, positron). Served to apps by
# GET /api/client-config. Used by: config/index.js, controllers/navigationController.js.
OPENFREEMAP_STYLE_URL=

# ---------------------------------------------------------------------------
# Search, nearby places and routing: Geoapify (https://www.geoapify.com)
# The key stays on the server: apps call the Hawr API, never Geoapify.
# ---------------------------------------------------------------------------
# GEOAPIFY_API_KEY - required for place search, reverse geocoding, nearby places and (unless
# ROUTING_OSRM_URL is set) routing. Without it those features answer 503 and everything else
# keeps working. Where: create a free project at https://myprojects.geoapify.com and copy its
# API key (3,000 credits a day free). In the Geoapify project, restrict the key to this
# server's IP address. Example: 0123456789abcdef0123456789abcdef. Used by:
# services/navigation/providerClient.js. Sent only in the x-api-key header, never logged.
GEOAPIFY_API_KEY=
# GEOAPIFY_DAILY_REQUEST_LIMIT - credits this server may spend per UTC day (0 = no limit).
# Optional. Default 2500, below the free plan's 3,000, so a busy day cannot cross the limit.
# One search is 1 credit, one routing request is 1 credit per route type (3 per route search).
GEOAPIFY_DAILY_REQUEST_LIMIT=
# ROUTING_OSRM_URL - optional: your own OSRM routing server. When set, routes come from it
# (no credits, real alternatives) and Geoapify is used only for search. Where: run
# https://github.com/Project-OSRM/osrm-backend with Iraq data from https://download.geofabrik.de .
# Example: http://127.0.0.1:5000 . Used by: services/navigation/routingService.js.
ROUTING_OSRM_URL=

# ---------------------------------------------------------------------------
# Secrets and tokens (32+ characters for the two signing secrets)
# ---------------------------------------------------------------------------
# DEVICE_TOKEN_SECRET - signs the anonymous device tokens of the apps. Required in
# production; blank = a key lost at every restart (everyone is signed out).
DEVICE_TOKEN_SECRET=
# USER_TOKEN_SECRET - signs user (login) tokens. Required in production. Must differ from
# DEVICE_TOKEN_SECRET.
USER_TOKEN_SECRET=
# NAV_ADMIN_TOKEN - admin console (/admin.html) and the operator endpoints of /api/v1.
# 16+ characters; a shorter value DISABLES administration. Never put it in an app.
NAV_ADMIN_TOKEN=
# TRAFFIC_INGEST_TOKEN - shared secret the Python AI service sends with every POST
# /api/traffic (Authorization: Bearer <token>). Set the same value on the AI service.
# Required in production; blank = anyone can post traffic data (development only).
TRAFFIC_INGEST_TOKEN=
# STREAM_ADMIN_TOKEN - bearer token for camera stream management (POST/PATCH/DELETE
# /api/streams). Optional; blank = stream management is disabled. Never give it to the AI service.
STREAM_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# AI cameras and intersections
# ---------------------------------------------------------------------------
# AI_STREAM_URL - public URL of the Python AI service, e.g. https://your-ai-service.onrender.com
# The Live AI tab loads <AI_STREAM_URL>/video/north, south, west and east from it. Optional.
AI_STREAM_URL=
# INTERSECTION_LAT / INTERSECTION_LNG / INTERSECTION_NAME - surveyed position of the
# intersection with id "main". Optional; blank = no position: the intersection is not drawn
# on maps and not matched to driver routes. (The other intersections get their coordinates in
# config/intersections.js.)
INTERSECTION_LAT=
INTERSECTION_LNG=
INTERSECTION_NAME=

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown). Everything else is in docs/CONFIGURATION.md.
# ---------------------------------------------------------------------------
# HISTORY_SAMPLE_SECONDS=5
# ROUTING_CACHE_TTL_SECONDS=300
# PLACES_CACHE_TTL_SECONDS=86400
# RATE_LIMIT_SEARCH_PER_MINUTE=15
# RATE_LIMIT_ROUTES_PER_MINUTE=10
# RATE_LIMIT_PLACES_PER_MINUTE=10
# NETWORK_OPTIMIZATION=true
