# Local secrets; the safe example is intentionally versionable.
.env
.env.*
!.env.example

# Existing local Python environment and generated bytecode.
.venv/
__pycache__/
*.py[cod]

# Audit tools, clean-install environment, and generated check caches.
.audit-tools/
.venv-audit/
.mypy_cache/
.ruff_cache/
audit/source-before.zip

# Large local inputs and training output are not source code.
AIModels/
videos/
runs/
*.zip

# Credentials, certificates and private local configuration.
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json
secrets/
.local/

# Environments, build/check artifacts, editors and operating systems.
.venv*/
venv/
env/
ENV/
.pytest_cache/
.coverage*
htmlcov/
build/
dist/
*.egg-info/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
tmp/
temp/
.cache/

# Experiments and binary assets stay on disk; tracked files need manual review.
audit/
wandb/
tensorboard/
lightning_logs/
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.mp4
*.avi
*.mov
*.mkv
*.webm
datasets/*
!datasets/.gitkeep
!datasets/README.md
