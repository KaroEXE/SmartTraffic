{
  "version": "1.0",
  "inputs": [
    {
      "type": "InferenceImage",
      "name": "image"
    }
  ],
  "steps": [
    {
      "type": "roboflow_core/roboflow_object_detection_model@v3",
      "name": "model",
      "images": "$inputs.image",
      "model_id": "emergency-car-xxgus/1"
    }
  ],
  "outputs": [
    {
      "type": "JsonField",
      "name": "predictions",
      "coordinates_system": "own",
      "selector": "$steps.model.predictions"
    }
  ]
}
