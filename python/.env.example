# Copy to root .env ONLY if it does not exist. Existing config/.env is also read.
# Nonempty process environment > root .env > existing config/.env.
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_PRIVATE_API_KEY
# Set these for your own workflow if you enable the optional API key.
ROBOFLOW_WORKSPACE=your-workspace
ROBOFLOW_WORKFLOW_ID=your-workflow-id
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Existing socket timeout in seconds. No retry/backoff setting is implemented.
ROBOFLOW_TIMEOUT=4

# Local read-only API. Keep loopback for local development.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Exact browser origins, comma-separated; blank means no cross-origin grants.
# Set it to the Node site's URL: its Live AI tab reads /api/cameras for stream status.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DISPLAY_FPS=8
JPEG_QUALITY=70
FRAME_STALE_SECONDS=10
# Simultaneous MJPEG viewers; each holds one server thread while open.
# One browser on the Live AI tab uses four (one per direction).
MAX_STREAM_CLIENTS=8

# Relative paths resolve from the repository root. No alternate model fallback.
MODEL_PATH=AI-models/yolo26n.pt
# auto = CUDA device 0 when PyTorch reports CUDA, otherwise CPU. Or cpu, 0, cuda:0.
YOLO_DEVICE=auto
# files (default): loop videos/video1.mp4 (north), video2.mp4 (south),
# video3.mp4 (west) and video4.mp4 (east), each at its own frame rate
# (VIDEO_FILES in config/config.py). cameras: use the VIDEO_* sources below.
VIDEO_SOURCE_MODE=files
# YOLO runs on every Nth processed frame of each stream; 2 is the original rate.
# Raise it to save CPU. Playback speed is real time either way: frames are
# skipped when inference falls behind.
DETECTION_FRAME_STRIDE=2
# cameras mode only. Leave blank to use the four videos listed in
# config/config.py. A local source can be videos/3Cars3.mp4; webcam 0 is camera:0.
VIDEO_NORTH=
VIDEO_SOUTH=
VIDEO_WEST=
VIDEO_EAST=

# Node.js backend that receives observations (POST {BACKEND_URL}/api/traffic).
# Blank disables publishing. Example: http://localhost:3000
BACKEND_URL=
# An id from the backend's config/intersections.js.
INTERSECTION_ID=main
# Shared secret; set the SAME value as TRAFFIC_INGEST_TOKEN on the backend.
TRAFFIC_INGEST_TOKEN=
BACKEND_PUBLISH_INTERVAL=1
BACKEND_TIMEOUT=5

# Production server only (wsgi.py / gunicorn.conf.py): seconds before the
# pipeline restarts after a failure or the end of a video; 0 disables.
PIPELINE_RESTART_SECONDS=10
LOG_LEVEL=INFO
